# Copie para .env e rode com: node --env-file=.env server/index.js
# (ou exporte as variáveis antes do npm start)

# Porta do site
PORTA=3000

# IP que os navegadores usam pra mandar vídeo pro servidor.
# Rede local: deixe vazio (detecta sozinho). VPS: coloque o IP público.
# IP_ANUNCIADO=203.0.113.10

# Porta única (UDP + TCP) por onde passa todo o vídeo
PORTA_RTC=40000

# Certificado próprio (ex: Let's Encrypt). Sem isso, gera um autoassinado.
# CERT_ARQUIVO=/etc/letsencrypt/live/seu-dominio/fullchain.pem
# CHAVE_ARQUIVO=/etc/letsencrypt/live/seu-dominio/privkey.pem

# Use false só se tiver um proxy (Nginx/Caddy) fazendo o HTTPS na frente
# HTTPS=false

# Limites
MAX_SALAS=50
MAX_PESSOAS=20
MINUTOS_SALA_VAZIA=30

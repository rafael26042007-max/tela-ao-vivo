# =====================================================
# Variáveis do servidor de sinalização
#   No seu PC:  node --env-file=.env server/index.js  (ou só npm start, sem .env)
#   No Render:  já vêm do render.yaml (dá pra mudar em Environment no painel)
# =====================================================

# Porta (o Render define PORT sozinho)
PORTA=3000

# Sites que podem usar este servidor, separados por vírgula
# ORIGENS_PERMITIDAS=https://rafael26042007-max.github.io

# true quando tem um proxy na frente (Render)
# CONFIAR_PROXY=true

# HTTPS próprio, só pra testar com outros PCs da sua rede
# (no localhost não precisa; no Render já vem pronto)
# HTTPS=true

# Limites
MAX_PESSOAS=8
# Maior limite que o dono pode escolher ao criar a sala
MAX_LIMITE_PESSOAS=12
MAX_TRANSMISSOES=4
MAX_SALAS=100
MINUTOS_SALA_VAZIA=30
SEGUNDOS_RECONECTAR=90

# Servidor TURN (opcional): ajuda quando a rede bloqueia conexão direta
# TURN_URL=turn:seu-turn.exemplo:3478
# TURN_USUARIO=usuario
# TURN_SENHA=senha

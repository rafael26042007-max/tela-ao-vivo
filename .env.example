# =====================================================
# Copie para .env e ajuste.
#   Rodar com: node --env-file=.env server/index.js
#   Na VPS, o serviço systemd (deploy/tela-ao-vivo.service) já lê o .env
# =====================================================

# ---------- Site ----------
PORTA=3000

# ---------- Vídeo (WebRTC) ----------
# IP que os navegadores usam pra mandar vídeo pro servidor.
# Rede local: deixe comentado (detecta sozinho). VPS: coloque o IP PÚBLICO.
# IP_ANUNCIADO=203.0.113.10

# Porta única (UDP + TCP) por onde passa todo o vídeo
PORTA_RTC=40000

# ---------- HTTPS ----------
# Opção A (VPS, recomendado): Caddy na frente fazendo o HTTPS (deploy/Caddyfile)
# HTTPS=false
# CONFIAR_PROXY=true

# Opção B: certificado próprio direto no Node
# CERT_ARQUIVO=/caminho/fullchain.pem
# CHAVE_ARQUIVO=/caminho/privkey.pem

# Sem nada disso: gera um certificado autoassinado (bom pra rede local)

# ---------- Limites ----------
MAX_SALAS=50
MAX_PESSOAS=20
MAX_TRANSMISSOES=4
MINUTOS_SALA_VAZIA=30

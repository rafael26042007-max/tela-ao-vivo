# =====================================================
# Serviço systemd: mantém o Tela ao Vivo rodando 24h na VPS
# - liga sozinho quando a VPS reinicia
# - religa sozinho se o programa cair
#
# Instalar:
#   sudo cp deploy/tela-ao-vivo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tela-ao-vivo
# Ver o log:
#   journalctl -u tela-ao-vivo -f
# =====================================================
[Unit]
Description=Tela ao Vivo (transmissão de tela)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tela
WorkingDirectory=/opt/tela-ao-vivo
EnvironmentFile=/opt/tela-ao-vivo/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

# ---------- Segurança: o programa não mexe no resto do sistema ----------
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

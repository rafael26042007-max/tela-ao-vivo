# =====================================================
# Caddy: HTTPS de verdade (Let's Encrypt) automático
# Troque "seu-dominio.exemplo" pelo seu domínio/subdomínio.
#
# Instalar:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# =====================================================
seu-dominio.exemplo {
	encode gzip
	# Repassa o site e o WebSocket (/ws) pro Node
	reverse_proxy localhost:3000
}

{
  "name": "tela-ao-vivo",
  "version": "1.0.0",
  "description": "Site de transmissão de tela ao vivo com salas e código de entrada. Várias pessoas podem transmitir; o servidor (SFU mediasoup) repassa o vídeo sem recodificar.",
  "main": "server/index.js",
  "scripts": {
    "build": "esbuild web/src/app.js --bundle --minify --sourcemap --target=es2020 --outfile=web/dist/app.js",
    "start": "npm run build && node server/index.js",
    "dev": "node scripts/dev.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael26042007-max/tela-ao-vivo.git"
  },
  "keywords": ["webrtc", "sfu", "mediasoup", "compartilhar-tela", "screen-share"],
  "author": "Rafael",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rafael26042007-max/tela-ao-vivo/issues"
  },
  "homepage": "https://github.com/rafael26042007-max/tela-ao-vivo#readme",
  "dependencies": {
    "mediasoup": "^3.32.2",
    "selfsigned": "^5.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mediasoup-client": "^3.26.0"
  }
}
